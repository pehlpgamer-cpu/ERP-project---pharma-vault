# Copy to .env.test (git-ignored). `npm test` loads it and refuses to run unless the database name ends in _test.
#
# Create the database once (as MySQL root), then push the schema with `npm run db:push:test`:
#   CREATE DATABASE xianfire_database_test;
#   GRANT ALL ON xianfire_database_test.* TO 'xianfire_user'@'%';
NODE_ENV=test
SECRET_KEY=test_secret_key
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=xianfire_database_test
MYSQL_USER=xianfire_user
MYSQL_PASSWORD=xianfire_password
DRIZZLE_STRICT=false
