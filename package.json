{
  "name": "xianfires-2.0.7-better-template",
  "version": "1.0.0",
  "description": "Pharma Vault: pharmacy point of sale, inventory and purchasing",
  "bin": {
    "xian": "./bin/xian.js"
  },
  "type": "module",
  "scripts": {
    "start": "node ./src/server.js",
    "xian": "nodemon ./src/server.js",
    "route:list": "node ./src/scripts/list-routes.js",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "node bin/test.js",
    "dep:check": "npx dependency-cruiser app database routes tests config src",
    "dep:svg": "npx dependency-cruiser src app views routes database config --output-type dot | dot -T svg > dependency-graph.svg",
    "dep:report": "npx dependency-cruiser --config --output-type err-html -f dependency-report.html app database routes tests config src",
    "dep:matrix": "npx dependency-cruiser -T html -f dependency-matrix.html app database routes tests config src",
    "db:push": "drizzle-kit push",
    "db:schema": "node scripts/export-schema.mjs",
    "db:bootstrap": "node database/seed/bootstrap.js",
    "db:push:test": "node --env-file=.env.test node_modules/drizzle-kit/bin.cjs push",
    "views:check": "node scripts/check-views.mjs",
    "db:seed": "node database/seed/index.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "chokidar": "^5.0.0",
    "connect-flash": "^0.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^4.19.2",
    "express-session": "^1.17.3",
    "hbs": "^4.2.0",
    "mysql2": "^3.24.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@japa/api-client": "^3.2.1",
    "@japa/expect": "^3.0.7",
    "@japa/expect-type": "^2.0.4",
    "@japa/runner": "^5.3.0",
    "dependency-cruiser": "^17.4.3",
    "drizzle-kit": "^1.0.0-rc.4",
    "nodemon": "^3.1.14",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0"
  },
  "engines": {
    "node": ">=24"
  }
}
