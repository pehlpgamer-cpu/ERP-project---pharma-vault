{{!-- inventory/counts: stock count list. Required: counts, total, canAdjust, statusOptions, pagination. --}}
<div class="mb-4 flex flex-wrap items-center justify-between gap-2">
  {{> components/page-header title="Stock counts" icon="clipboard-check"}}
  {{#if canAdjust}}
  <a href="/stock-counts/new" class="btn"><i class="bi bi-plus-lg" aria-hidden="true"></i> New count</a>
  {{/if}}
</div>

<form method="GET" action="/stock-counts" class="mb-4 flex flex-wrap items-end gap-3 border border-gray-200 bg-white p-3">
  <label class="text-sm text-gray-700">Status
    <select name="status" class="field">
      {{#each statusOptions}}
      <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
      {{/each}}
    </select>
  </label>
  <button type="submit" class="btn"><i class="bi bi-funnel" aria-hidden="true"></i> Filter</button>
  <a href="/stock-counts" class="btn bg-gray-200">Reset</a>
</form>

{{#if counts.length}}
<div class="overflow-x-auto border border-gray-200 bg-white">
  <table class="w-full text-left text-sm">
    <thead class="bg-gray-50 text-gray-600">
      <tr>
        <th class="cell">Count</th>
        <th class="cell">Branch</th>
        <th class="cell">Reason</th>
        <th class="cell">Started by</th>
        <th class="cell">Created</th>
        <th class="cell">Status</th>
      </tr>
    </thead>
    <tbody>
      {{#each counts}}
      <tr class="border-t border-gray-200">
        <td class="cell whitespace-nowrap font-medium"><a href="/stock-counts/{{id}}" class="text-blue-700 underline">{{adjustmentNumber}}</a></td>
        <td class="cell">{{branchName}}</td>
        <td class="cell">{{reason}}</td>
        <td class="cell">{{createdByName}}</td>
        <td class="cell whitespace-nowrap">{{formatDateTime createdAt}}</td>
        <td class="cell">{{badge status}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{> components/pagination pagination=pagination}}
{{else}}
{{> components/empty-state icon="clipboard-check" title="No stock counts" hint="Count a batch on the shelf to correct what the books say."}}
{{/if}}
