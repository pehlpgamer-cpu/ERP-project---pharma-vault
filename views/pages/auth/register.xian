<div class="mx-auto flex max-w-md flex-col px-4 py-12">
  <form class="flex flex-col gap-1 rounded-2xl border border-slate-200 bg-white p-8 shadow-lg shadow-blue-900/5" method="POST" action="/register">
    <span class="mx-auto mb-2 flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-600 text-xl text-white shadow-sm" aria-hidden="true"><i class="bi bi-person-plus"></i></span>
    <h2 class="mb-4 text-center text-2xl font-bold tracking-tight">Register</h2>
    <label class="text-sm font-medium text-slate-700">Name
      <input type="text" name="name" placeholder="Name" class="field" required />
    </label>
    <label class="mt-2 text-sm font-medium text-slate-700">Email
      <input type="email" name="email" placeholder="Email" class="field" required />
    </label>
    <label class="mt-2 text-sm font-medium text-slate-700">Password
      <input type="password" name="password" placeholder="Password" class="field" required />
    </label>
    <button type="submit" class="btn mt-5 w-full py-2.5">Register</button>
    <a href="/login-page" class="mt-3 text-center text-sm text-blue-700 hover:underline">Already have an account? Login</a>
  </form>
</div>
