{{!-- purchasing/orders: purchase order list. Required: orders, total, canManage, statusOptions, pagination. --}}
<div class="mb-4 flex flex-wrap items-center justify-between gap-2">
  {{> components/page-header title="Purchase orders" icon="cart-check"}}
  <div class="flex gap-2">
    <a href="/suppliers" class="btn bg-gray-200"><i class="bi bi-truck" aria-hidden="true"></i> Suppliers</a>
    {{#if canManage}}
    <a href="/purchase-orders/new" class="btn"><i class="bi bi-plus-lg" aria-hidden="true"></i> New order</a>
    {{/if}}
  </div>
</div>

<form method="GET" action="/purchase-orders" class="mb-4 flex flex-wrap items-end gap-3 border border-gray-200 bg-white p-3">
  <label class="text-sm text-gray-700">Status
    <select name="status" class="field">
      {{#each statusOptions}}
      <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
      {{/each}}
    </select>
  </label>
  <button type="submit" class="btn"><i class="bi bi-funnel" aria-hidden="true"></i> Filter</button>
  <a href="/purchase-orders" class="btn bg-gray-200">Reset</a>
</form>

{{#if orders.length}}
<div class="overflow-x-auto border border-gray-200 bg-white">
  <table class="w-full text-left text-sm">
    <thead class="bg-gray-50 text-gray-600">
      <tr>
        <th class="cell">Order</th>
        <th class="cell">Supplier</th>
        <th class="cell">Branch</th>
        <th class="cell">Expected</th>
        <th class="cell text-right">Total</th>
        <th class="cell">Status</th>
      </tr>
    </thead>
    <tbody>
      {{#each orders}}
      <tr class="border-t border-gray-200">
        <td class="cell whitespace-nowrap font-medium"><a href="/purchase-orders/{{id}}" class="text-blue-700 underline">{{poNumber}}</a></td>
        <td class="cell">{{supplierName}}</td>
        <td class="cell">{{branchName}}</td>
        <td class="cell whitespace-nowrap">{{#if expectedDate}}{{formatDate expectedDate}}{{else}}<span class="text-gray-400">-</span>{{/if}}</td>
        <td class="cell text-right">{{currency total}}</td>
        <td class="cell">{{badge status}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{> components/pagination pagination=pagination}}
{{else}}
{{> components/empty-state icon="cart-check" title="No purchase orders" hint="Create an order to buy stock from a supplier."}}
{{/if}}
