{{!--
  purchasing/order-form: write or edit a draft purchase order. Required: values (supplierId, expectedDate, notes),
  errors (by field), isNew, action, orderNumber, lineRows, supplierOptions, unitOptions.
--}}
{{#if isNew}}
{{> components/page-header title="New purchase order" icon="cart-check"}}
{{else}}
{{> components/page-header title="Edit purchase order" icon="cart-check" subtitle=orderNumber}}
{{/if}}

{{#if errors.lines}}
<div class="mb-4 border border-red-300 bg-red-50 p-3 text-sm text-red-800" role="alert">{{errors.lines}}</div>
{{/if}}

<form method="POST" action="{{action}}" class="grid gap-4" novalidate>
  <section class="grid gap-3 border border-gray-200 bg-white p-4 sm:grid-cols-2 lg:grid-cols-3" aria-labelledby="header-title">
    <h2 id="header-title" class="text-base font-semibold sm:col-span-2 lg:col-span-3">Order</h2>
    <label class="text-sm text-gray-700">Supplier
      <select name="supplierId" required class="field">
        <option value="">Choose a supplier</option>
        {{#each supplierOptions}}
        <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
      {{#if errors.supplierId}}<span class="mt-1 block text-xs text-red-700">{{errors.supplierId}}</span>{{/if}}
    </label>
    <label class="text-sm text-gray-700">Expected delivery
      <input type="date" name="expectedDate" value="{{values.expectedDate}}" class="field">
      {{#if errors.expectedDate}}<span class="mt-1 block text-xs text-red-700">{{errors.expectedDate}}</span>{{/if}}
    </label>
    <label class="text-sm text-gray-700 sm:col-span-2 lg:col-span-3">Notes
      <textarea name="notes" rows="2" maxlength="2000" class="field">{{values.notes}}</textarea>
      {{#if errors.notes}}<span class="mt-1 block text-xs text-red-700">{{errors.notes}}</span>{{/if}}
    </label>
  </section>

  <section class="border border-gray-200 bg-white p-4" aria-labelledby="lines-title">
    <h2 id="lines-title" class="mb-1 text-base font-semibold">Lines</h2>
    <p class="mb-3 text-sm text-gray-600">Quantity and cost are per purchase unit (for example per box). Leave unused rows empty.</p>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="text-gray-600">
          <tr>
            <th class="cell">Product and unit</th>
            <th class="cell">Quantity</th>
            <th class="cell">Unit cost</th>
          </tr>
        </thead>
        <tbody>
          {{#each lineRows}}
          <tr class="align-top">
            <td class="cell">
              <select name="lines[{{index}}][productUnitId]" aria-label="Product and unit" class="field">
                <option value="">-</option>
                {{#each @root.unitOptions}}
                <option value="{{id}}" {{#if (eq id ../productUnitId)}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
              {{#if errors.productUnitId}}<span class="mt-1 block text-xs text-red-700">{{errors.productUnitId}}</span>{{/if}}
            </td>
            <td class="cell">
              <input type="text" inputmode="decimal" name="lines[{{index}}][quantity]" value="{{quantity}}" aria-label="Quantity" class="field">
              {{#if errors.quantity}}<span class="mt-1 block text-xs text-red-700">{{errors.quantity}}</span>{{/if}}
            </td>
            <td class="cell">
              <input type="text" inputmode="decimal" name="lines[{{index}}][unitCost]" value="{{unitCost}}" aria-label="Unit cost" class="field">
              {{#if errors.unitCost}}<span class="mt-1 block text-xs text-red-700">{{errors.unitCost}}</span>{{/if}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>

  <div class="flex gap-2">
    <button type="submit" class="btn"><i class="bi bi-check-lg" aria-hidden="true"></i> Save draft</button>
    <a href="/purchase-orders" class="btn bg-gray-200">Cancel</a>
  </div>
</form>
