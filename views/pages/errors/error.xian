{{!-- errors/error: shared by the 401, 403, 404 and 500 pages. Required: status, heading, message, detail (null hides the stack). --}}
<section class="mx-auto mt-16 max-w-xl border border-gray-200 bg-white p-6">
  <p class="text-5xl font-bold text-blue-600">{{status}}</p>
  <h1 class="mt-2 text-2xl font-bold">{{heading}}</h1>
  <p class="mt-2 text-gray-700">{{message}}</p>
  <p class="mt-6">
    <a href="/" class="btn inline-flex items-center gap-2">
      <i class="bi bi-house" aria-hidden="true"></i>
      Back to home
    </a>
  </p>
  {{#if detail}}
  <pre class="mt-6 overflow-auto border border-gray-200 bg-gray-50 p-3 text-xs">{{detail}}</pre>
  {{/if}}
</section>
