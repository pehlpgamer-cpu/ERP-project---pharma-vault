{{!--
  returns/show: one return with its lines and next steps. Required: salesReturn, lines, refunds (a list, empty until processed),
  refundRows, dispositionLabels, canSubmit, canApprove, needsOtherApprover, canReject, canProcess, canCancel.
--}}
<div class="mb-4 flex flex-wrap items-center justify-between gap-2">
  {{> components/page-header title=salesReturn.returnNumber icon="arrow-return-left"}}
  <a href="/returns" class="btn bg-gray-200"><i class="bi bi-list-ul" aria-hidden="true"></i> All returns</a>
</div>

<section class="mb-4 grid gap-3 border border-gray-200 bg-white p-4 text-sm sm:grid-cols-2 lg:grid-cols-4" aria-label="Return details">
  <div><span class="block text-gray-500">Status</span>{{badge salesReturn.status}}</div>
  <div><span class="block text-gray-500">Sale</span><a href="/sales/{{salesReturn.saleId}}" class="text-blue-700 underline">{{salesReturn.invoiceNumber}}</a></div>
  <div><span class="block text-gray-500">Branch</span>{{salesReturn.branchName}}</div>
  <div><span class="block text-gray-500">Refund</span>{{currency salesReturn.refundAmount}}</div>
  <div><span class="block text-gray-500">Started by</span>{{salesReturn.createdByName}}</div>
  <div><span class="block text-gray-500">Approved by</span>{{#if salesReturn.approvedByName}}{{salesReturn.approvedByName}}{{else}}-{{/if}}</div>
  <div><span class="block text-gray-500">Created</span>{{formatDateTime salesReturn.createdAt}}</div>
  <div><span class="block text-gray-500">Refunded</span>{{#each refunds}}<span class="block">{{paymentMethod method}} {{currency amount}}{{#if referenceNumber}} &middot; {{referenceNumber}}{{/if}}</span>{{else}}-{{/each}}</div>
  <div class="sm:col-span-2 lg:col-span-4"><span class="block text-gray-500">Reason</span>{{salesReturn.reason}}</div>
</section>

<div class="mb-4 overflow-x-auto border border-gray-200 bg-white">
  <table class="w-full text-left text-sm">
    <thead class="bg-gray-50 text-gray-600">
      <tr>
        <th class="cell">Product</th>
        <th class="cell">Batch</th>
        <th class="cell text-right">Quantity</th>
        <th class="cell">Units go to</th>
        <th class="cell text-right">Refund</th>
      </tr>
    </thead>
    <tbody>
      {{#each lines}}
      <tr class="border-t border-gray-200">
        <td class="cell">{{productName}}</td>
        <td class="cell">{{#if batchNumber}}{{batchNumber}}{{else}}-{{/if}}</td>
        <td class="cell text-right">{{formatNumber quantity}}</td>
        <td class="cell">{{lookup @root.dispositionLabels disposition}}</td>
        <td class="cell text-right">{{currency refundAmount}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>

{{#if needsOtherApprover}}
<p class="mb-3 text-sm text-gray-600">You started this return, so someone else with approval rights must approve it.</p>
{{/if}}

<div class="flex flex-wrap items-start gap-3">
  {{#if canSubmit}}
  <form method="POST" action="/returns/{{salesReturn.id}}/submit"><button type="submit" class="btn">Submit for approval</button></form>
  {{/if}}
  {{#if canApprove}}
  <form method="POST" action="/returns/{{salesReturn.id}}/approve"><button type="submit" class="btn">Approve</button></form>
  {{/if}}
  {{#if canReject}}
  <details>
    <summary class="btn cursor-pointer bg-gray-200">Reject</summary>
    <form method="POST" action="/returns/{{salesReturn.id}}/reject" class="mt-1 flex flex-col gap-1">
      <input type="text" name="reason" required maxlength="500" placeholder="Why it is rejected" aria-label="Reason" class="field">
      <button type="submit" class="btn">Reject return</button>
    </form>
  </details>
  {{/if}}
  {{#if canProcess}}
  <form method="POST" action="/returns/{{salesReturn.id}}/process" class="flex flex-col gap-2 border border-gray-200 bg-white p-3 text-sm" data-confirm="Process this return? Stock is restocked and the refund is paid out.">
    <h2 class="font-semibold">Pay the refund</h2>
    <p class="text-gray-600">Refund of {{currency salesReturn.refundAmount}}, paid back the way the sale was paid. Fill in the amount for each method; they must add up. Card, e-wallet and bank refunds need a reference.</p>
    {{#each refundRows}}
    <div class="grid gap-2 sm:grid-cols-3">
      <input type="hidden" name="refunds[{{index}}][method]" value="{{method}}">
      <span class="self-end">{{paymentMethod method}} <span class="text-gray-500">(up to {{currency left}})</span></span>
      <label class="text-gray-700">Amount
        <input type="text" inputmode="decimal" name="refunds[{{index}}][amount]" value="{{amount}}" class="field">
      </label>
      <label class="text-gray-700">Reference
        <input type="text" name="refunds[{{index}}][referenceNumber]" maxlength="150" class="field">
      </label>
    </div>
    {{/each}}
    <button type="submit" class="btn">Process return</button>
  </form>
  {{/if}}
  {{#if canCancel}}
  <details>
    <summary class="cursor-pointer text-red-700 underline">Cancel return</summary>
    <form method="POST" action="/returns/{{salesReturn.id}}/cancel" class="mt-1 flex flex-col gap-1" data-confirm="Cancel this return? This cannot be undone.">
      <input type="text" name="reason" required maxlength="500" placeholder="Reason" aria-label="Reason" class="field">
      <button type="submit" class="btn">Cancel return</button>
    </form>
  </details>
  {{/if}}
</div>
