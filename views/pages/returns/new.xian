{{!--
  returns/new: draft a return for one sale. Required: sale, blocked (sentence or null), values (reason),
  errors (by field), rows (one per batch piece).
--}}
{{> components/page-header title="New return" icon="arrow-return-left"}}

<p class="mb-4 text-sm text-gray-700">Sale <a href="/sales/{{sale.id}}" class="text-blue-700 underline">{{sale.invoiceNumber}}</a> &middot; {{badge sale.status}} &middot; total {{currency sale.totalAmount}}</p>

{{#if errors.lines}}
<div class="mb-4 border border-red-300 bg-red-50 p-3 text-sm text-red-800" role="alert">{{errors.lines}}</div>
{{/if}}

{{#if blocked}}
<div class="border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900" role="alert">{{blocked}}</div>
<p class="mt-3"><a href="/sales/{{sale.id}}" class="btn bg-gray-200">Back to the sale</a></p>
{{else}}
<form method="POST" action="/sales/{{sale.id}}/returns" class="grid gap-4" novalidate>
  <section class="border border-gray-200 bg-white p-4" aria-labelledby="why-title">
    <h2 id="why-title" class="mb-2 text-base font-semibold">Why</h2>
    <label class="text-sm text-gray-700">Reason
      <input type="text" name="reason" value="{{values.reason}}" maxlength="500" required class="field" placeholder="Wrong strength, customer changed mind, damaged on delivery">
      {{#if errors.reason}}<span class="mt-1 block text-xs text-red-700">{{errors.reason}}</span>{{/if}}
    </label>
  </section>

  <section class="border border-gray-200 bg-white p-4" aria-labelledby="lines-title">
    <h2 id="lines-title" class="mb-1 text-base font-semibold">What comes back</h2>
    <p class="mb-3 text-sm text-gray-600">Quantities are in base units (for example tablets). Leave a row empty to keep it. Only restocked units go back on the shelf: a pharmacist decides that, so never assume opened or unsealed medicine can be sold again.</p>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="text-gray-600">
          <tr>
            <th class="cell">Product</th>
            <th class="cell">Batch</th>
            <th class="cell text-right">Sold</th>
            <th class="cell text-right">Can return</th>
            <th class="cell">Return</th>
            <th class="cell">Units go to</th>
          </tr>
        </thead>
        <tbody>
          {{#each rows}}
          <tr class="align-top">
            <td class="cell">{{productName}}</td>
            <td class="cell">{{batchNumber}}{{#if expirationDate}} <span class="text-gray-500">exp {{expirationDate}}</span>{{/if}}</td>
            <td class="cell text-right">{{formatNumber sold}}</td>
            <td class="cell text-right">{{formatNumber remaining}}</td>
            <td class="cell">
              <input type="hidden" name="lines[{{index}}][saleItemBatchId]" value="{{id}}">
              <input type="text" inputmode="decimal" name="lines[{{index}}][quantity]" value="{{quantity}}" aria-label="Quantity to return" class="field">
              {{#if errors.quantity}}<span class="mt-1 block text-xs text-red-700">{{errors.quantity}}</span>{{/if}}
            </td>
            <td class="cell">
              <select name="lines[{{index}}][disposition]" aria-label="Units go to" class="field">
                {{#each dispositions}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
              {{#if errors.disposition}}<span class="mt-1 block text-xs text-red-700">{{errors.disposition}}</span>{{/if}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>

  <div class="flex gap-2">
    <button type="submit" class="btn"><i class="bi bi-check-lg" aria-hidden="true"></i> Save draft</button>
    <a href="/sales/{{sale.id}}" class="btn bg-gray-200">Cancel</a>
  </div>
</form>
{{/if}}
