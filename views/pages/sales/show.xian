{{!-- sales/show: the receipt. Prints the stored sale snapshot only; reprinting never re-runs a sale. Required: sale, autoPrint. --}}
<div class="no-print">
  {{> components/page-header title="Sale details" icon="receipt"}}
</div>

<article id="receipt" data-auto-print="{{autoPrint}}" class="mx-auto max-w-3xl border border-gray-200 bg-white p-6">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="text-sm text-gray-600">Invoice</p>
      <p class="text-xl font-bold">{{sale.invoiceNumber}}</p>
      <p class="mt-1">{{badge sale.status}}</p>
    </div>
    <div class="text-sm text-gray-700 sm:text-right">
      <p>{{formatDateTime sale.transactionDate}}</p>
      <p>{{sale.branch.name}} &middot; {{sale.register.name}}</p>
      <p>Cashier: {{sale.cashier.name}}</p>
      {{#if sale.customer}}
      <p>Customer: {{sale.customer.name}} ({{sale.customer.customerNumber}})</p>
      {{/if}}
    </div>
  </div>

  <div class="mt-6 overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="border-b border-gray-300 text-gray-600">
        <tr>
          <th class="py-2 pr-3 font-medium">Product</th>
          <th class="py-2 pr-3 font-medium">Unit</th>
          <th class="py-2 pr-3 text-right font-medium">Qty</th>
          <th class="py-2 pr-3 text-right font-medium">Unit price</th>
          <th class="py-2 text-right font-medium">Amount</th>
        </tr>
      </thead>
      <tbody>
        {{#each sale.items}}
        <tr class="border-b border-gray-200 align-top">
          <td class="py-2 pr-3">
            {{productName}}
            {{#if genericName}}<span class="block text-xs text-gray-500">{{genericName}}</span>{{/if}}
            {{#if batches.length}}
            <details class="mt-1 text-xs text-gray-600">
              <summary class="cursor-pointer">Batches ({{batches.length}})</summary>
              <ul class="mt-1 list-inside list-disc">
                {{#each batches}}
                <li>{{batchNumber}} &middot; expires {{#if expirationDate}}{{expirationDate}}{{else}}never{{/if}} &middot; {{formatNumber quantity}} units</li>
                {{/each}}
              </ul>
            </details>
            {{/if}}
          </td>
          <td class="py-2 pr-3">{{unit.name}}</td>
          <td class="py-2 pr-3 text-right">{{formatNumber quantity}}</td>
          <td class="py-2 pr-3 text-right">{{currency unitPrice}}</td>
          <td class="py-2 text-right">{{currency total}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  <dl class="mt-4 ml-auto grid max-w-xs grid-cols-2 gap-x-4 gap-y-1 text-sm">
    <dt class="text-gray-600">Subtotal</dt>
    <dd class="text-right">{{currency sale.totals.subtotal}}</dd>
    {{#if (gt sale.totals.discount 0)}}
    <dt class="text-gray-600">Discount</dt>
    <dd class="text-right">-{{currency sale.totals.discount}}</dd>
    {{/if}}
    {{#if (gt sale.totals.tax 0)}}
    <dt class="text-gray-600">Tax</dt>
    <dd class="text-right">{{currency sale.totals.tax}}</dd>
    {{/if}}
    <dt class="border-t border-gray-300 pt-1 font-bold">Total</dt>
    <dd class="border-t border-gray-300 pt-1 text-right font-bold">{{currency sale.totals.total}}</dd>
    <dt class="text-gray-600">Paid</dt>
    <dd class="text-right">{{currency sale.totals.paid}}</dd>
    <dt class="text-gray-600">Change</dt>
    <dd class="text-right">{{currency sale.totals.change}}</dd>
  </dl>

  <h2 class="mt-6 text-sm font-semibold text-gray-700">Payments</h2>
  <table class="mt-1 w-full text-left text-sm">
    <tbody>
      {{#each sale.payments}}
      <tr class="border-b border-gray-200">
        <td class="py-1 pr-3">{{paymentMethod method}}</td>
        <td class="py-1 pr-3 text-gray-600">{{#if reference}}{{reference}}{{/if}}</td>
        <td class="py-1 pr-3">{{badge status}}</td>
        <td class="py-1 text-right">{{currency amount}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <div class="no-print mt-6 flex flex-wrap gap-2">
    <button type="button" class="btn" data-print><i class="bi bi-printer" aria-hidden="true"></i> Print receipt</button>
    {{#if canReturn}}
    <a href="/sales/{{sale.id}}/return" class="btn bg-gray-200"><i class="bi bi-arrow-return-left" aria-hidden="true"></i> Return items</a>
    {{/if}}
    <a href="/sales" class="btn bg-gray-200"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to sales</a>
  </div>
</article>

<script>
  (() => {
    const receipt = document.getElementById('receipt');
    const button = document.querySelector('[data-print]');
    if (button) button.addEventListener('click', () => window.print());
    if (receipt && receipt.dataset.autoPrint === 'true') {
      // print once: drop ?print=1 so a reload or Back does not reopen the dialog
      history.replaceState(null, '', location.pathname);
      window.print();
    }
  })();
</script>
