{{!-- prescriptions/index: prescription list. Required: prescriptions, total, q, canRecord, statusOptions, pagination. --}}
<div class="mb-4 flex flex-wrap items-center justify-between gap-2">
  {{> components/page-header title="Prescriptions" icon="file-medical"}}
  {{#if canRecord}}
  <a href="/prescriptions/new" class="btn"><i class="bi bi-plus-lg" aria-hidden="true"></i> Record a prescription</a>
  {{/if}}
</div>

<form method="GET" action="/prescriptions" class="mb-4 flex flex-wrap items-end gap-3 border border-gray-200 bg-white p-3">
  <label class="text-sm text-gray-700">Number
    <input type="search" name="q" value="{{q}}" class="field" placeholder="RX-MAIN-...">
  </label>
  <label class="text-sm text-gray-700">Status
    <select name="status" class="field">
      {{#each statusOptions}}
      <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
      {{/each}}
    </select>
  </label>
  <button type="submit" class="btn"><i class="bi bi-funnel" aria-hidden="true"></i> Filter</button>
  <a href="/prescriptions" class="btn bg-gray-200">Reset</a>
</form>

{{#if prescriptions.length}}
<div class="overflow-x-auto border border-gray-200 bg-white">
  <table class="w-full text-left text-sm">
    <thead class="bg-gray-50 text-gray-600">
      <tr>
        <th class="cell">Prescription</th>
        <th class="cell">Prescriber</th>
        <th class="cell">Customer</th>
        <th class="cell">Written</th>
        <th class="cell">Valid until</th>
        <th class="cell">Status</th>
      </tr>
    </thead>
    <tbody>
      {{#each prescriptions}}
      <tr class="border-t border-gray-200">
        <td class="cell whitespace-nowrap font-medium"><a href="/prescriptions/{{id}}" class="text-blue-700 underline">{{prescriptionNumber}}</a></td>
        <td class="cell">{{physicianName}}</td>
        <td class="cell">{{#if customerName}}{{customerName}}{{else}}-{{/if}}</td>
        <td class="cell whitespace-nowrap">{{prescriptionDate}}</td>
        <td class="cell whitespace-nowrap">{{#if validUntil}}{{validUntil}}{{else}}-{{/if}}</td>
        <td class="cell">{{badge status}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{> components/pagination pagination=pagination}}
{{else}}
{{> components/empty-state icon="file-medical" title="No prescriptions" hint="Record a prescription so a pharmacist can verify it."}}
{{/if}}
