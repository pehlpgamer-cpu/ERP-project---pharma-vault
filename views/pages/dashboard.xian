{{> components/page-header title="Dashboard" icon="speedometer2"}}

{{#unless hasAccess}}
<div class="border border-amber-300 bg-amber-50 p-4 text-amber-900">
  <p class="font-medium"><i class="bi bi-hourglass-split" aria-hidden="true"></i> Your account is awaiting access</p>
  <p class="mt-1 text-sm">An administrator has to give you a role before the dashboard shows anything.</p>
</div>
{{else}}
{{#if hasSalesData}}
<div class="mb-4 flex flex-wrap items-center gap-2">
  {{#if canSell}}
  <a href="/pos-page" class="btn"><i class="bi bi-cart-check" aria-hidden="true"></i> New sale</a>
  {{/if}}
  {{#if openSession}}
  <p class="text-sm text-gray-700"><i class="bi bi-cash-stack" aria-hidden="true"></i> Register {{openSession.registerName}} open since {{formatDateTime openSession.openedAt}}</p>
  {{else}}
  {{#if canManageRegister}}
  <a href="/cash-register-page" class="btn bg-gray-200"><i class="bi bi-cash-stack" aria-hidden="true"></i> Open a register</a>
  {{/if}}
  {{/if}}
</div>

<div class="mb-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
  {{> components/stat-card label="Sales today" value=today.salesCount icon="receipt" hint=(concat fortnight.salesCount " in the last 14 days")}}
  {{> components/stat-card label="Gross sales today" value=(currency today.grossSales) icon="cash-coin" hint=(concat "Yesterday " (currency today.yesterdayGross))}}
  {{> components/stat-card label="Gross sales, last 14 days" value=(currency fortnight.grossSales) icon="graph-up"}}
  {{> components/stat-card label="Average sale, last 14 days" value=(currency fortnight.averageSale) icon="calculator"}}
</div>

<div class="mb-4 grid gap-4 xl:grid-cols-3">
  <div class="xl:col-span-2">
    {{> components/daily-chart}}
  </div>
  <div>
    {{> components/payment-bars}}
  </div>
</div>

<section class="border border-gray-200 bg-white">
  <div class="flex items-center justify-between border-b border-gray-200 p-4">
    <h2 class="text-base font-semibold">Latest sales</h2>
    <a href="/sales" class="text-sm text-blue-700 underline">View all sales</a>
  </div>
  {{#if recentSales.length}}
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="bg-gray-50 text-gray-600">
        <tr>
          <th class="cell">Invoice</th>
          <th class="cell">Time</th>
          <th class="cell">Cashier</th>
          <th class="cell text-right">Total</th>
          <th class="cell">Status</th>
        </tr>
      </thead>
      <tbody>
        {{#each recentSales}}
        <tr class="border-t border-gray-200">
          <td class="cell"><a href="/sales/{{id}}" class="font-medium text-blue-700 underline">{{invoiceNumber}}</a></td>
          <td class="cell whitespace-nowrap">{{formatDateTime transactionDate}}</td>
          <td class="cell">{{cashier.name}}</td>
          <td class="cell text-right font-medium">{{currency totals.total}}</td>
          <td class="cell">{{badge status}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{else}}
  <div class="p-4">
    {{> components/empty-state icon="receipt" title="No sales yet" hint="Completed sales appear here."}}
  </div>
  {{/if}}
</section>
{{else}}
<div class="border border-gray-200 bg-white p-4 text-gray-700">
  <p><i class="bi bi-info-circle" aria-hidden="true"></i> Your role has no sales figures to show here.</p>
  {{#if canSell}}
  <p class="mt-3"><a href="/pos-page" class="btn"><i class="bi bi-cart-check" aria-hidden="true"></i> New sale</a></p>
  {{/if}}
</div>
{{/if}}
{{/unless}}

<style type="text/tailwindcss">
  {{>css/viz}}
</style>
