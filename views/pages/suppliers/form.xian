{{!-- suppliers/form: create or edit a supplier. Required: values, errors (by field), isNew, action. --}}
{{#if isNew}}
{{> components/page-header title="New supplier" icon="truck"}}
{{else}}
{{> components/page-header title="Edit supplier" icon="truck"}}
{{/if}}

<form method="POST" action="{{action}}" class="grid gap-3 border border-gray-200 bg-white p-4 sm:grid-cols-2" novalidate>
  <label class="text-sm text-gray-700">Code
    <input type="text" name="code" value="{{values.code}}" maxlength="50" required class="field">
    {{#if errors.code}}<span class="mt-1 block text-xs text-red-700">{{errors.code}}</span>{{/if}}
  </label>
  <label class="text-sm text-gray-700">Name
    <input type="text" name="name" value="{{values.name}}" maxlength="255" required class="field">
    {{#if errors.name}}<span class="mt-1 block text-xs text-red-700">{{errors.name}}</span>{{/if}}
  </label>
  <label class="text-sm text-gray-700">Contact person
    <input type="text" name="contactName" value="{{values.contactName}}" maxlength="255" class="field">
    {{#if errors.contactName}}<span class="mt-1 block text-xs text-red-700">{{errors.contactName}}</span>{{/if}}
  </label>
  <label class="text-sm text-gray-700">Phone
    <input type="text" name="phone" value="{{values.phone}}" maxlength="50" class="field">
    {{#if errors.phone}}<span class="mt-1 block text-xs text-red-700">{{errors.phone}}</span>{{/if}}
  </label>
  <label class="text-sm text-gray-700">Email
    <input type="email" name="email" value="{{values.email}}" maxlength="255" class="field">
    {{#if errors.email}}<span class="mt-1 block text-xs text-red-700">{{errors.email}}</span>{{/if}}
  </label>
  <label class="text-sm text-gray-700">Tax ID
    <input type="text" name="taxId" value="{{values.taxId}}" maxlength="100" class="field">
    {{#if errors.taxId}}<span class="mt-1 block text-xs text-red-700">{{errors.taxId}}</span>{{/if}}
  </label>
  <label class="text-sm text-gray-700 sm:col-span-2">Payment terms
    <input type="text" name="paymentTerms" value="{{values.paymentTerms}}" maxlength="255" placeholder="For example Net 30" class="field">
    {{#if errors.paymentTerms}}<span class="mt-1 block text-xs text-red-700">{{errors.paymentTerms}}</span>{{/if}}
  </label>
  <label class="text-sm text-gray-700 sm:col-span-2">Address
    <textarea name="address" rows="2" maxlength="2000" class="field">{{values.address}}</textarea>
    {{#if errors.address}}<span class="mt-1 block text-xs text-red-700">{{errors.address}}</span>{{/if}}
  </label>
  {{#unless isNew}}
  <label class="flex items-center gap-2 text-sm text-gray-700 sm:col-span-2">
    <input type="checkbox" name="isActive" {{#if values.isActive}}checked{{/if}}>
    Active (can be chosen on new purchase orders)
  </label>
  {{/unless}}
  <div class="flex gap-2 sm:col-span-2">
    <button type="submit" class="btn"><i class="bi bi-check-lg" aria-hidden="true"></i> Save supplier</button>
    <a href="/suppliers" class="btn bg-gray-200">Cancel</a>
  </div>
</form>
