{{!--
  transfers/new: request stock from another branch, in two steps. Required: sources (branches, with selected),
  source (the chosen branch or null), errors (by field), lineRows, batchOptions, batchesCapped.
--}}
{{> components/page-header title="Request a transfer" icon="truck"}}

<form method="GET" action="/transfers/new" class="mb-4 flex flex-wrap items-end gap-3 border border-gray-200 bg-white p-4">
  <label class="text-sm text-gray-700">Request from
    <select name="source" class="field">
      <option value="">Choose a branch</option>
      {{#each sources}}
      <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} ({{code}})</option>
      {{/each}}
    </select>
  </label>
  <button type="submit" class="btn">Show its stock</button>
</form>

{{#if errors.sourceBranchId}}
<div class="mb-4 border border-red-300 bg-red-50 p-3 text-sm text-red-800" role="alert">{{errors.sourceBranchId}}</div>
{{/if}}
{{#if errors.lines}}
<div class="mb-4 border border-red-300 bg-red-50 p-3 text-sm text-red-800" role="alert">{{errors.lines}}</div>
{{/if}}

{{#if source}}
<form method="POST" action="/transfers" class="grid gap-4" novalidate>
  <input type="hidden" name="sourceBranchId" value="{{source.id}}">
  <section class="border border-gray-200 bg-white p-4" aria-labelledby="lines-title">
    <h2 id="lines-title" class="mb-1 text-base font-semibold">Batches wanted from {{source.name}}</h2>
    <p class="mb-3 text-sm text-gray-600">Quantities are in base units (for example tablets). {{source.name}} approves the request, then ships what it can. Leave unused rows empty.</p>
    {{#if batchesCapped}}<p class="mb-3 text-sm text-amber-800" role="note">Only the first 500 batches are listed.</p>{{/if}}
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="text-gray-600">
          <tr>
            <th class="cell">Batch</th>
            <th class="cell">Quantity</th>
          </tr>
        </thead>
        <tbody>
          {{#each lineRows}}
          <tr class="align-top">
            <td class="cell">
              <select name="lines[{{index}}][sourceBatchId]" aria-label="Batch" class="field">
                <option value="">-</option>
                {{#each @root.batchOptions}}
                <option value="{{id}}" {{#if (eq id ../sourceBatchId)}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
              {{#if errors.sourceBatchId}}<span class="mt-1 block text-xs text-red-700">{{errors.sourceBatchId}}</span>{{/if}}
            </td>
            <td class="cell">
              <input type="text" inputmode="decimal" name="lines[{{index}}][quantity]" value="{{quantity}}" aria-label="Quantity" class="field">
              {{#if errors.quantity}}<span class="mt-1 block text-xs text-red-700">{{errors.quantity}}</span>{{/if}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>

  <div class="flex gap-2">
    <button type="submit" class="btn"><i class="bi bi-check-lg" aria-hidden="true"></i> Save draft</button>
    <a href="/transfers" class="btn bg-gray-200">Cancel</a>
  </div>
</form>
{{/if}}
