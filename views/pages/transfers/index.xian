{{!-- transfers/index: stock transfer list. Required: transfers, total, canRequest, statusOptions, pagination. --}}
<div class="mb-4 flex flex-wrap items-center justify-between gap-2">
  {{> components/page-header title="Transfers" icon="truck"}}
  {{#if canRequest}}
  <a href="/transfers/new" class="btn"><i class="bi bi-plus-lg" aria-hidden="true"></i> Request stock</a>
  {{/if}}
</div>

<form method="GET" action="/transfers" class="mb-4 flex flex-wrap items-end gap-3 border border-gray-200 bg-white p-3">
  <label class="text-sm text-gray-700">Status
    <select name="status" class="field">
      {{#each statusOptions}}
      <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
      {{/each}}
    </select>
  </label>
  <button type="submit" class="btn"><i class="bi bi-funnel" aria-hidden="true"></i> Filter</button>
  <a href="/transfers" class="btn bg-gray-200">Reset</a>
</form>

{{#if transfers.length}}
<div class="overflow-x-auto border border-gray-200 bg-white">
  <table class="w-full text-left text-sm">
    <thead class="bg-gray-50 text-gray-600">
      <tr>
        <th class="cell">Transfer</th>
        <th class="cell">From</th>
        <th class="cell">To</th>
        <th class="cell">Requested by</th>
        <th class="cell">Created</th>
        <th class="cell">Status</th>
      </tr>
    </thead>
    <tbody>
      {{#each transfers}}
      <tr class="border-t border-gray-200">
        <td class="cell whitespace-nowrap font-medium"><a href="/transfers/{{id}}" class="text-blue-700 underline">{{transferNumber}}</a></td>
        <td class="cell">{{sourceBranchName}}</td>
        <td class="cell">{{destinationBranchName}}</td>
        <td class="cell">{{requestedByName}}</td>
        <td class="cell whitespace-nowrap">{{formatDateTime createdAt}}</td>
        <td class="cell">{{badge status}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{> components/pagination pagination=pagination}}
{{else}}
{{> components/empty-state icon="truck" title="No transfers" hint="Request stock from another branch to start one."}}
{{/if}}
