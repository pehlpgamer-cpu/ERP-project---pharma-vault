{{!--
  purchase-returns/new: draft a supplier return. Required: values (supplierId, reason), suppliers, errors (by field),
  lineRows, batchOptions, batchesCapped.
--}}
{{> components/page-header title="Return stock to a supplier" icon="box-arrow-up"}}

{{#if errors.lines}}
<div class="mb-4 border border-red-300 bg-red-50 p-3 text-sm text-red-800" role="alert">{{errors.lines}}</div>
{{/if}}

<form method="POST" action="/purchase-returns" class="grid gap-4" novalidate>
  <section class="grid gap-3 border border-gray-200 bg-white p-4 sm:grid-cols-2" aria-labelledby="why-title">
    <h2 id="why-title" class="text-base font-semibold sm:col-span-2">Why and to whom</h2>
    <label class="text-sm text-gray-700">Supplier
      <select name="supplierId" class="field" required>
        <option value="">Choose a supplier</option>
        {{#each suppliers}}
        <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} ({{code}})</option>
        {{/each}}
      </select>
      {{#if errors.supplierId}}<span class="mt-1 block text-xs text-red-700">{{errors.supplierId}}</span>{{/if}}
    </label>
    <label class="text-sm text-gray-700">Reason
      <input type="text" name="reason" value="{{values.reason}}" maxlength="500" required class="field" placeholder="Wrong item, damaged, recall, discrepancy">
      {{#if errors.reason}}<span class="mt-1 block text-xs text-red-700">{{errors.reason}}</span>{{/if}}
    </label>
  </section>

  <section class="border border-gray-200 bg-white p-4" aria-labelledby="lines-title">
    <h2 id="lines-title" class="mb-1 text-base font-semibold">Batches going back</h2>
    <p class="mb-3 text-sm text-gray-600">Quantities are in base units (for example tablets). Active, quarantined, recalled and expired batches can be returned. Leave unused rows empty.</p>
    {{#if batchesCapped}}<p class="mb-3 text-sm text-amber-800" role="note">Only the first 500 batches are listed.</p>{{/if}}
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="text-gray-600">
          <tr>
            <th class="cell">Batch</th>
            <th class="cell">Quantity</th>
          </tr>
        </thead>
        <tbody>
          {{#each lineRows}}
          <tr class="align-top">
            <td class="cell">
              <select name="lines[{{index}}][inventoryBatchId]" aria-label="Batch" class="field">
                <option value="">-</option>
                {{#each @root.batchOptions}}
                <option value="{{id}}" {{#if (eq id ../inventoryBatchId)}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
              {{#if errors.inventoryBatchId}}<span class="mt-1 block text-xs text-red-700">{{errors.inventoryBatchId}}</span>{{/if}}
            </td>
            <td class="cell">
              <input type="text" inputmode="decimal" name="lines[{{index}}][quantity]" value="{{quantity}}" aria-label="Quantity" class="field">
              {{#if errors.quantity}}<span class="mt-1 block text-xs text-red-700">{{errors.quantity}}</span>{{/if}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>

  <div class="flex gap-2">
    <button type="submit" class="btn"><i class="bi bi-check-lg" aria-hidden="true"></i> Save draft</button>
    <a href="/purchase-returns" class="btn bg-gray-200">Cancel</a>
  </div>
</form>
