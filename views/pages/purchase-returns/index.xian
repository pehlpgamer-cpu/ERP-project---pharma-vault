{{!-- purchase-returns/index: supplier return list. Required: returns, total, canDraft, statusOptions, pagination. --}}
<div class="mb-4 flex flex-wrap items-center justify-between gap-2">
  {{> components/page-header title="Supplier returns" icon="box-arrow-up"}}
  {{#if canDraft}}
  <a href="/purchase-returns/new" class="btn"><i class="bi bi-plus-lg" aria-hidden="true"></i> New return</a>
  {{/if}}
</div>

<form method="GET" action="/purchase-returns" class="mb-4 flex flex-wrap items-end gap-3 border border-gray-200 bg-white p-3">
  <label class="text-sm text-gray-700">Status
    <select name="status" class="field">
      {{#each statusOptions}}
      <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
      {{/each}}
    </select>
  </label>
  <button type="submit" class="btn"><i class="bi bi-funnel" aria-hidden="true"></i> Filter</button>
  <a href="/purchase-returns" class="btn bg-gray-200">Reset</a>
</form>

{{#if returns.length}}
<div class="overflow-x-auto border border-gray-200 bg-white">
  <table class="w-full text-left text-sm">
    <thead class="bg-gray-50 text-gray-600">
      <tr>
        <th class="cell">Return</th>
        <th class="cell">Supplier</th>
        <th class="cell">Branch</th>
        <th class="cell">Reason</th>
        <th class="cell">Started by</th>
        <th class="cell">Created</th>
        <th class="cell">Status</th>
      </tr>
    </thead>
    <tbody>
      {{#each returns}}
      <tr class="border-t border-gray-200">
        <td class="cell whitespace-nowrap font-medium"><a href="/purchase-returns/{{id}}" class="text-blue-700 underline">{{returnNumber}}</a></td>
        <td class="cell">{{supplierName}}</td>
        <td class="cell">{{branchName}}</td>
        <td class="cell">{{reason}}</td>
        <td class="cell">{{createdByName}}</td>
        <td class="cell whitespace-nowrap">{{formatDateTime createdAt}}</td>
        <td class="cell">{{badge status}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{> components/pagination pagination=pagination}}
{{else}}
{{> components/empty-state icon="box-arrow-up" title="No supplier returns" hint="Send damaged, wrong or recalled stock back to its supplier."}}
{{/if}}
