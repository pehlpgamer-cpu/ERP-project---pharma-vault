{{!-- components/stat-card: one number with a label. Required: label, value, icon. Optional: hint. --}}
<div class="flex items-start gap-3 border border-gray-200 bg-white p-4">
  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-100 text-blue-700">
    <i class="bi bi-{{icon}} text-xl" aria-hidden="true"></i>
  </span>
  <div class="min-w-0">
    <p class="text-sm font-medium text-slate-600">{{label}}</p>
    <p class="truncate text-2xl font-bold tracking-tight">{{value}}</p>
    {{#if hint}}
    <p class="text-xs text-slate-500">{{hint}}</p>
    {{/if}}
  </div>
</div>
