{{!-- components/page-header: the title row of a page. Required: title, icon. Optional: subtitle. --}}
<header class="mb-5 flex flex-wrap items-center gap-x-3 gap-y-1">
  <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-100 text-blue-700" aria-hidden="true">
    <i class="bi bi-{{icon}} text-xl"></i>
  </span>
  <h1 class="text-2xl font-bold tracking-tight text-slate-900">{{title}}</h1>
  {{#if subtitle}}
  <p class="text-slate-600">{{subtitle}}</p>
  {{/if}}
</header>
