{{!-- components/empty-state: shown instead of an empty table. Required: icon, title. Optional: hint. --}}
<div class="flex flex-col items-center gap-2 rounded-xl border border-dashed border-blue-200 bg-white p-10 text-center text-slate-600">
  <span class="flex h-14 w-14 items-center justify-center rounded-full bg-blue-50 text-blue-500" aria-hidden="true">
    <i class="bi bi-{{icon}} text-3xl"></i>
  </span>
  <p class="font-semibold text-slate-800">{{title}}</p>
  {{#if hint}}
  <p class="max-w-md text-sm">{{hint}}</p>
  {{/if}}
</div>
