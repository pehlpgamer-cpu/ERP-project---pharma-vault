{{!-- components/empty-state: shown instead of an empty table. Required: icon, title. Optional: hint. --}}
<div class="flex flex-col items-center gap-2 border border-dashed border-gray-300 bg-white p-8 text-center text-gray-600">
  <i class="bi bi-{{icon}} text-4xl text-gray-400" aria-hidden="true"></i>
  <p class="font-medium text-gray-800">{{title}}</p>
  {{#if hint}}
  <p class="text-sm">{{hint}}</p>
  {{/if}}
</div>
