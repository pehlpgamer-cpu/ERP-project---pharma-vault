{{!-- sideNavBar: main navigation, filtered by the signed-in user's permissions. Needs currentUser and currentPath. --}}
<nav class="flex flex-1 flex-col gap-1 p-3" aria-label="Main">
  <a href="/dashboard-page" class="nav-link {{#if (isActive currentPath "/dashboard-page")}}nav-link-active{{/if}}">
    <i class="bi bi-speedometer2" aria-hidden="true"></i> Dashboard
  </a>
  {{#if (can "sales.view.own" "sales.view.branch" "sales.view.all")}}
  <a href="/sales" class="nav-link {{#if (isActive currentPath "/sales")}}nav-link-active{{/if}}">
    <i class="bi bi-receipt" aria-hidden="true"></i> Sales
  </a>
  {{/if}}
  {{#if (can "prescriptions.manage" "prescriptions.verify")}}
  <a href="/prescriptions" class="nav-link {{#if (isActive currentPath "/prescriptions")}}nav-link-active{{/if}}">
    <i class="bi bi-file-medical" aria-hidden="true"></i> Prescriptions
  </a>
  {{/if}}
  {{#if (can "returns.create" "returns.approve")}}
  <a href="/returns" class="nav-link {{#if (isActive currentPath "/returns")}}nav-link-active{{/if}}">
    <i class="bi bi-arrow-return-left" aria-hidden="true"></i> Returns
  </a>
  {{/if}}
  {{#if (can "sales.create")}}
  <a href="/pos-page" class="nav-link {{#if (isActive currentPath "/pos-page")}}nav-link-active{{/if}}">
    <i class="bi bi-cart-check" aria-hidden="true"></i> New sale
  </a>
  {{/if}}
  {{#if (can "register.manage")}}
  <a href="/cash-register-page" class="nav-link {{#if (isActive currentPath "/cash-register-page")}}nav-link-active{{/if}}">
    <i class="bi bi-cash-stack" aria-hidden="true"></i> Cash register
  </a>
  {{/if}}
  {{#if (can "inventory.view")}}
  <a href="/inventory" class="nav-link {{#if (isActive currentPath "/inventory")}}nav-link-active{{/if}}">
    <i class="bi bi-boxes" aria-hidden="true"></i> Inventory
  </a>
  <a href="/stock-counts" class="nav-link {{#if (isActive currentPath "/stock-counts")}}nav-link-active{{/if}}">
    <i class="bi bi-clipboard-check" aria-hidden="true"></i> Stock counts
  </a>
  {{/if}}
  {{#if (can "transfers.manage" "transfers.approve")}}
  <a href="/transfers" class="nav-link {{#if (isActive currentPath "/transfers")}}nav-link-active{{/if}}">
    <i class="bi bi-truck" aria-hidden="true"></i> Transfers
  </a>
  {{/if}}
  {{#if (can "inventory.view")}}
  <a href="/reports/movements" class="nav-link {{#if (isActive currentPath "/reports/movements")}}nav-link-active{{/if}}">
    <i class="bi bi-clock-history" aria-hidden="true"></i> Movements
  </a>
  {{/if}}
  {{#if (can "audit.view")}}
  <a href="/audit" class="nav-link {{#if (isActive currentPath "/audit")}}nav-link-active{{/if}}">
    <i class="bi bi-shield-check" aria-hidden="true"></i> Audit trail
  </a>
  {{/if}}
  {{#if (can "purchasing.view")}}
  <a href="/purchase-orders" class="nav-link {{#if (isActive currentPath "/purchase-orders")}}nav-link-active{{/if}}">
    <i class="bi bi-cart-check" aria-hidden="true"></i> Purchasing
  </a>
  <a href="/suppliers" class="nav-link {{#if (isActive currentPath "/suppliers")}}nav-link-active{{/if}}">
    <i class="bi bi-truck" aria-hidden="true"></i> Suppliers
  </a>
  {{/if}}
  {{#if (can "products.manage")}}
  <a href="/products" class="nav-link {{#if (isActive currentPath "/products")}}nav-link-active{{/if}}">
    <i class="bi bi-capsule" aria-hidden="true"></i> Products
  </a>
  {{/if}}
  {{#if (can "users.manage")}}
  <a href="/users" class="nav-link {{#if (isActive currentPath "/users")}}nav-link-active{{/if}}">
    <i class="bi bi-people" aria-hidden="true"></i> Users
  </a>
  {{/if}}
  <div class="flex-1"></div>
  <form method="POST" action="/logout">
    <button type="submit" class="nav-link w-full cursor-pointer text-left">
      <i class="bi bi-box-arrow-right" aria-hidden="true"></i> Sign out
    </button>
  </form>
</nav>
