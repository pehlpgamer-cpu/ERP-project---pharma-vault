{{!-- authenticated layout: the app shell for signed-in users. Needs currentUser and currentPath (set by the loadUser middleware). --}}
{{>head}}

<body class="text-slate-900">
  <div class="flex min-h-screen">
    <aside id="app-sidebar" class="fixed inset-y-0 left-0 z-30 hidden w-64 shrink-0 flex-col bg-blue-950 text-blue-100 shadow-xl md:sticky md:top-0 md:flex md:h-screen md:shadow-none">
      <a href="/dashboard-page" class="flex items-center gap-3 px-5 py-5 text-lg font-semibold tracking-tight text-white">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-600 shadow-sm">
          <i class="bi bi-capsule-pill" aria-hidden="true"></i>
        </span>
        Pharma Vault
      </a>
      {{>sideNavBar}}
    </aside>
    <div class="flex min-w-0 flex-1 flex-col">
      <header id="app-header" class="sticky top-0 z-20 flex items-center gap-3 border-b border-slate-200 bg-white/90 px-4 py-2.5 backdrop-blur md:px-6">
        <button type="button" id="nav-toggle" class="btn md:hidden" aria-label="Toggle navigation" aria-controls="app-sidebar">
          <i class="bi bi-list" aria-hidden="true"></i>
        </button>
        <div class="flex-1"></div>
        <div class="text-right text-sm leading-tight">
          <p class="font-semibold text-slate-800">{{currentUser.name}}</p>
          {{#if currentUser.branchName}}
          <p class="text-slate-500">{{currentUser.branchName}}</p>
          {{/if}}
        </div>
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-blue-100 text-blue-700" aria-hidden="true">
          <i class="bi bi-person-fill text-lg"></i>
        </span>
      </header>
      <main class="flex-1 p-4 md:p-6">
        {{{body}}}
      </main>
      <div id="app-footer">
        {{>footer}}
      </div>
    </div>
  </div>

  <script>
    // A form posts once: a second click on Save (or Enter) while the first request is on its way would
    // create a second document. Confirm dialogs cancel the first submit, so only a submit that goes
    // ahead locks the form; the lock is lifted when the page is shown again from the back button.
    (() => {
      document.addEventListener('submit', (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement) || form.method.toLowerCase() !== 'post') return;
        if (form.dataset.submitting === '1') {
          event.preventDefault();
          return;
        }
        if (event.defaultPrevented) return;
        form.dataset.submitting = '1';
        setTimeout(() => {
          form.querySelectorAll('button[type="submit"], button:not([type])').forEach((button) => {
            button.disabled = true;
          });
        }, 0);
      });
      window.addEventListener('pageshow', (event) => {
        if (!event.persisted) return;
        document.querySelectorAll('form[data-submitting]').forEach((form) => {
          delete form.dataset.submitting;
          form.querySelectorAll('button[disabled]').forEach((button) => {
            button.disabled = false;
          });
        });
      });
    })();
    (() => {
      const button = document.getElementById('nav-toggle');
      const sidebar = document.getElementById('app-sidebar');
      if (!button || !sidebar) return;
      button.addEventListener('click', () => {
        sidebar.classList.toggle('hidden');
        sidebar.classList.toggle('flex');
      });
    })();
  </script>
  <style type="text/tailwindcss">
  {{>css/base}}
  @layer components {
    .nav-link { @apply flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium text-blue-100/80 transition-colors hover:bg-white/10 hover:text-white; }
    .nav-link-active { @apply bg-blue-600 text-white shadow-sm hover:bg-blue-600; }
  }
  /* A printed receipt is the receipt only: no navigation, header or footer around it. */
  @media print {
    #app-sidebar, #app-header, #app-footer, .no-print { display: none !important; }
    main { padding: 0 !important; }
  }
  </style>
</body>
</html>
