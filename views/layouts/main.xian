{{!-- main layout: public pages (home, login, register) and errors for signed-out visitors. --}}
{{>head}}

<body class="flex min-h-screen flex-col">
    <nav class="flex flex-wrap items-center gap-2 border-b border-slate-200 bg-white px-4 py-3 md:px-8">
        <a href="/" class="flex items-center gap-3 text-lg font-semibold tracking-tight text-blue-950">
            <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-600 text-white shadow-sm">
                <i class="bi bi-capsule-pill" aria-hidden="true"></i>
            </span>
            Pharma Vault
        </a>
        <div class="flex-1"></div>
        <div class="flex gap-2">
            <a href="/" class="btn bg-gray-200">Home</a>
            <a href="/login-page" class="btn bg-gray-200">Login</a>
            <a href="/register-page" class="btn">Register</a>
        </div>
    </nav>
    <main class="flex-1">
        {{{body}}}
    </main>
    {{>footer}}

    <style type="text/tailwindcss">
    {{>css/base}}
    </style>
</body>
</html>
