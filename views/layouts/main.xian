{{!-- main layout: public pages (home, login, register) and errors for signed-out visitors. --}}
{{>head}}

<body class="bg-gray-50 flex flex-col min-h-screen">
    <nav class="bg-default border-b-1 p-2 gap-2 flex flex-wrap items-center">
        <a href="/" class="font-bold flex items-center text-3xl hover:scale-106 duration-150 cursor-pointer">
            <i class="bi bi-fire text-red-600" aria-hidden="true"></i>
            <div>
                XIANFIRE
            </div>
        </a>
        <div class="flex-1"></div>
        <div class="flex gap-2">
            <a href="/" class="btn">Home</a>
            <a href="/login-page" class="btn">Login</a>
            <a href="/register-page" class="btn">Register</a>
        </div>
    </nav>
    <main class="flex-1">
        {{{body}}}
    </main>
    {{>footer}}

    <style type="text/tailwindcss">
    {{>css/base}}
    </style>
</body>
</html>
