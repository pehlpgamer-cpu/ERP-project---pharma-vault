# Production image for Pharma Vault. Built and run by compose.prod.yaml.
FROM node:24-bookworm-slim

WORKDIR /app

ENV NODE_ENV=production \
    NPM_CONFIG_UPDATE_NOTIFIER=false

COPY package.json package-lock.json ./

# runtime dependencies only (no test, lint or desktop-packaging tools)
RUN npm ci --omit=dev && npm cache clean --force

COPY --chown=node:node . .

USER node

EXPOSE 3000

# src/server.js builds the view engine before it listens; src/app.js alone never listens.
CMD ["node", "src/server.js"]
