# The test environment inside the development stack (compose.dev.yaml mounts this over .env.test in the
# `test` container only). `npm test` loads .env.test with override, so without this a host .env.test
# that points at a database on your machine would win over the compose settings.
# Local-only credentials; they match the mysql service in compose.dev.yaml.
NODE_ENV=test
SECRET_KEY=test_secret_key
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=pharma_vault_test
MYSQL_USER=pharma_vault
MYSQL_PASSWORD=pharma_vault_dev
DRIZZLE_STRICT=false
