# APPLICATION
NODE_ENV=development
PORT=3000
SECRET_KEY=super_secret_key_123
# Business time zone used for display, "today" and day grouping (data is stored in UTC)
APP_TIMEZONE=Asia/Manila
# Session cookie: defaults to secure when NODE_ENV=production. Set false to serve production over plain HTTP.
# SESSION_COOKIE_SECURE=false
# Number of proxies in front of the app (for example 1 behind a reverse proxy)
# TRUST_PROXY=1
# A batch is sellable until its expiry date minus this many days (0 = through the printed date)
EXPIRY_BUFFER_DAYS=0
# Register variances above this amount need a note and manager review
REGISTER_VARIANCE_THRESHOLD=50.00

# MYSQL CONTAINER
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=xianfire_database
MYSQL_USER=xianfire_user
MYSQL_PASSWORD=xianfire_password
MYSQL_ROOT_PASSWORD=xianfire_root_password
# drizzle-kit push asks for confirmation unless this is false
DRIZZLE_STRICT=true

# DEMO DATA (npm run db:seed): password for every seeded account, at least 14 characters
SEED_PASSWORD=PharmaVault-demo-2026

# REDIS
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# MAILPIT
# MAIL_HOST=mailpit
# MAIL_PORT=1025

# MAIL_FROM_ADDRESS=noreply@xianfire.local
# MAIL_FROM_NAME=XianFire


# ARGON2
ARGON2_TYPE=2 # 2 = argon2id
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=19456
ARGON2_PARALLELISM=1
ARGON2_HASH_LENGTH=32
