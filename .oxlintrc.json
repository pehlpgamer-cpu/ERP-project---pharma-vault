{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "scripts/check-views.mjs",
    ".claude/**",
    ".planning/**",
    ".superpowers/**",
    "docs/**",
    "database/sql/**"
  ],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eslint/curly": [
      "error",
      "all"
    ],
    "arrow-body-style": [
      "error",
      "always",
      {
        "requireReturnForObjectLiteral": true
      }
    ],
    "default-case-last": "error",
    "default-param-last": "error"
  },
  "env": {
    "builtin": true
  }
}
