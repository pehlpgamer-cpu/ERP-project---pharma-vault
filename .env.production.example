# Copy to .env.production on the VPS and fill in every value (the file is git-ignored; never commit it).
# Used with:  docker compose --env-file .env.production -f compose.prod.yaml up -d --build

# --- Cloudflare Tunnel -------------------------------------------------------------------------
# From Cloudflare Zero Trust > Networks > Tunnels > your tunnel > "Install and run a connector":
# the long string after `--token`. See docs/DEPLOYMENT.md.
TUNNEL_TOKEN=

# --- Application -------------------------------------------------------------------------------
# Signs the session cookies. Generate one:  openssl rand -hex 48
SECRET_KEY=
# Business time zone for display, "today" and day grouping (data is stored in UTC)
APP_TIMEZONE=Asia/Manila
# A batch is sellable until its expiry date minus this many days (0 = through the printed date)
EXPIRY_BUFFER_DAYS=0
# Register variances above this amount need a note and manager review
REGISTER_VARIANCE_THRESHOLD=50.00
# Lets another system (the pharmacy queue) look up medicines read-only. Leave empty to switch the
# endpoint off. Generate one:  openssl rand -hex 32   (see docs/INTEGRATIONS.md)
INTEGRATION_API_TOKEN=

# --- Database ----------------------------------------------------------------------------------
# Used the first time the database starts, and by the app and the backup job afterwards. Changing
# them later does NOT change the existing database: change the MySQL users inside MySQL as well.
# Generate each:  openssl rand -base64 24
MYSQL_DATABASE=pharma_vault
MYSQL_USER=pharma_vault
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Backups -----------------------------------------------------------------------------------
BACKUP_KEEP_DAYS=14
